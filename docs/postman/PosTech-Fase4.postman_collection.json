          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Passo assíncrono: o evento atravessa o RabbitMQ. Se ainda não chegou,",
                  "// repete esta mesma requisição (até 10 vezes, com o delay do runner).",
                  "const chave = 'tentativa:' + pm.info.requestName;",
                  "const tentativas = Number(pm.collectionVariables.get(chave) || 0);",
                  "let pronto = false; try { pronto = pm.response.code === 200 && pm.response.json().passo === 'AguardandoDiagnostico'; } catch (e) { pronto = false; }",
                  "if (!pronto && tentativas < 10) {",
                  "  pm.collectionVariables.set(chave, tentativas + 1);",
                  "  console.log('ainda não, tentativa', tentativas + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "pm.collectionVariables.unset(chave);",
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "const s = pm.response.json(); console.log('passo:', s.passo, '| status da ordem:', s.statusDaOrdem);",
                  "pm.test('saga em AguardandoDiagnostico', () => pm.expect(s.passo).to.eql('AguardandoDiagnostico'));"
                ]
              }
            }
          ]
        },
